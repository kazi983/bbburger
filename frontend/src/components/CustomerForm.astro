<div
  class="rounded-default border border-outline-variant bg-surface-container-lowest p-space-lg shadow-sm"
>
  <h2 class="mb-1.5 flex items-center gap-space-sm font-bold">
    <span class="material-symbols-outlined" aria-hidden="true">
      person
    </span>
    Customer Details
  </h2>

  <p class="mb-4 text-sm text-on-surface-variant">
    Enter your name so we can identify your pickup order.
  </p>

  <label
    for="customer-name-input"
    class="mb-2 block text-sm font-semibold"
  >
    Customer Name <span class="text-primary">*</span>
  </label>

  <input
    type="text"
    id="customer-name-input"
    name="customerName"
    autocomplete="name"
    placeholder="Enter your full name"
    required
    maxlength="100"
    aria-describedby="customer-name-error"
    class="w-full rounded-default border border-outline-variant bg-surface-container-low px-4 py-3 text-on-surface focus:border-primary"
  />

  <p
    id="customer-name-error"
    class="mt-2 min-h-5 text-sm text-error"
    aria-live="polite"
  ></p>
</div>

<script>
  const nameInput = document.querySelector<HTMLInputElement>(
    "#customer-name-input"
  );

  const nameError = document.querySelector("#customer-name-error");

  function validateCustomerName() {
    if (!nameInput) return;

    const isValid = nameInput.value.trim().length > 0;

    nameInput.setCustomValidity(
      isValid ? "" : "Please enter your name."
    );

    nameInput.setAttribute("aria-invalid", String(!isValid));

    if (nameError) {
      nameError.textContent = isValid ? "" : "Please enter your name.";
    }
  }

  nameInput?.addEventListener("blur", validateCustomerName);

  nameInput?.addEventListener("input", () => {
    if (nameInput.getAttribute("aria-invalid") === "true") {
      validateCustomerName();
    }
  });
</script>
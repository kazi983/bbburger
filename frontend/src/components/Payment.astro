---
export interface Props {
	subtotal?: number;
	tax?: number;
	total?: number;
}

//Dummy number
const { subtotal = 17.77, tax = 1.42, total = 19.19 } = Astro.props;
---

<div class="bg-surface-container-lowest rounded-default p-space-lg mb-space-lg border border-outline-variant shadow-sm">
	<div class="flex justify-between items-center mb-3">
		<h3 class="font-label-lg text-label-lg m-0">🧾 Payment Breakdown</h3>
	</div>
	<div class="flex justify-between font-body-md text-body-md text-on-surface-variant mb-2.5">
		<span>Subtotal</span>
		<span id="subtotal-amount">CAD {subtotal.toFixed(2)}</span>
	</div>
	<div class="flex justify-between font-body-md text-body-md text-on-surface-variant mb-2.5">
		<span>Estimated Tax & Surcharge <span class="text-label-sm font-normal">(8%)</span></span>
		<span id="tax-amount">CAD {tax.toFixed(2)}</span>
	</div>
	<div class="h-px bg-outline-variant my-3"></div>
	<div class="flex justify-between items-center">
		<span class="font-label-lg text-label-lg text-on-surface">Total Due</span>
		<span class="font-headline-md text-headline-md text-primary" id="total-amount">CAD {total.toFixed(2)}</span>
	</div>
	<div class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">Includes all local taxes and fees</div>
</div>

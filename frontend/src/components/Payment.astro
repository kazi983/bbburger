---
export interface Props {
	subtotal?: number;
	tax?: number;
	total?: number;
}

//Dummy number
const { subtotal = 17.77, tax = 1.42, total = 19.19 } = Astro.props;
---

<div class="bg-white rounded-2xl p-5 mb-5 border border-[#F3E6DE] shadow-sm">
	<div class="flex justify-between items-center mb-3">
		<h3 class="text-base font-bold m-0">🧾 Payment Breakdown</h3>
	</div>
	<div class="flex justify-between text-sm text-[#6B6B6B] mb-2.5">
		<span>Subtotal</span>
		<span id="subtotal-amount">CAD {subtotal.toFixed(2)}</span>
	</div>
	<div class="flex justify-between text-sm text-[#6B6B6B] mb-2.5">
		<span>Estimated Tax & Surcharge <span class="text-[11px]">(8%)</span></span>
		<span id="tax-amount">CAD {tax.toFixed(2)}</span>
	</div>
	<div class="h-px bg-[#F3E6DE] my-3"></div>
	<div class="flex justify-between items-center">
		<span class="text-base font-bold text-[#1A1A1A]">Total Due</span>
		<span class="text-2xl font-extrabold text-[#D9381E]" id="total-amount">CAD {total.toFixed(2)}</span>
	</div>
	<div class="text-[11px] text-[#6B6B6B] mt-1">Includes all local taxes and fees</div>
</div>
---
type Props = {
  orderID: number;
  customerName: string;
  //   items: Items[];
  completedAt: string;
  total: string;
};

const { orderID, customerName, completedAt, total } = Astro.props;
---

<div class="bg-white p-5 shadow-xl hover:bg-[#fbede3]">
  <table class="table-auto">
    <tbody>
      <tr>
        <td class="text-3xl font-bold"># {orderID}</td>
        <td>
          <div
            class="flex flex-row justify-center items-center gap-2 bg-[#A3F69C] text-[#005312] px-3 py-2 rounded-full w-fit ml-auto"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="1em"
              height="1em"
              viewBox="0 0 2048 2048"
              class="fill-current"
            >
              <path d="M0 0h2048v2048H0z" fill="none"></path>
              <path
                d="M1024 0q141 0 272 36t244 104t207 160t161 207t103 245t37 272q0 141-36 272t-104 244t-160 207t-207 161t-245 103t-272 37q-141 0-272-36t-244-104t-207-160t-161-207t-103-245t-37-272q0-141 36-272t104-244t160-207t207-161T752 37t272-37m603 685l-136-136l-659 659l-275-275l-136 136l411 411z"
              ></path>
            </svg>

            <span>Complete</span>
          </div></td
        >
      </tr>

      <tr>
        <td colspan="2" class="font-bold">{customerName}</td>
      </tr>
      <tr>
        <td colspan="2"
          >1x Smoky BBQ Bacon Combo, 1x Mega Fries, 1x Large Lemonade</td
        >
      </tr>
      <tr>
        <td>Completed at:</td>
        <td class="text-right">{completedAt}</td>
      </tr>
      <tr>
        <td class="font-bold text-xl">TOTAL</td>
        <td class="text-right font-bold text-xl">CAD {total}</td>
      </tr>
    </tbody>
  </table>
</div>

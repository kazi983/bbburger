---
interface Props {
  active: "menu" | "cart" | "tracking" | "orders";
}

const { active } = Astro.props;

const navItems = [
  {
    id: "menu",
    label: "Menu",
    href: "/menu",
    icon: "fastfood",
  },
  {
    id: "cart",
    label: "Cart",
    href: "/cart",
    icon: "shopping_bag",
  },
  {
    id: "tracking",
    label: "Status",
    href: "/tracking",
    icon: "fact_check",
  },
  {
    id: "orders",
    label: "Orders",
    href: "/orders",
    icon: "receipt_long",
  },
] as const;
---

<nav
  class="fixed bottom-0 left-0 z-50 flex w-full items-center justify-around rounded-t-lg border-t border-outline-variant/20 bg-surface px-4 py-2 shadow-lg"
>
  <a
    class="flex flex-col items-center justify-center px-3 py-1.5 text-on-surface-variant transition-colors hover:text-primary"
    href="/menu"
  >
    <span class="material-symbols-outlined">fastfood</span>
    <span class="mt-0.5 text-label-sm font-label-sm">Menu</span>
  </a>

  <a
    class="flex flex-col items-center justify-center px-3 py-1.5 text-on-surface-variant transition-colors hover:text-primary"
    href="/cart"
  >
    <span class="material-symbols-outlined">shopping_bag</span>
    <span class="mt-0.5 text-label-sm font-label-sm">Cart</span>
  </a>

  <a
    aria-current="page"
    class="flex flex-col items-center justify-center rounded-full bg-primary-container px-4 py-1.5 text-on-primary-container transition-all"
    href="/tracking"
  >
    <span class="material-symbols-outlined fill-icon">fact_check</span>
    <span class="mt-0.5 text-label-sm font-label-sm font-bold">Status</span>
  </a>

  <a
    class="flex flex-col items-center justify-center px-3 py-1.5 text-on-surface-variant transition-colors hover:text-primary"
    href="/orders"
  >
    <span class="material-symbols-outlined">receipt_long</span>
    <span class="mt-0.5 text-label-sm font-label-sm">Orders</span>
  </a>
</nav>

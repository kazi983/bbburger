---
export interface Props {
	total?: number;
}

//Dummy data
const { total = 19.19 } = Astro.props;
---

<div class="fixed bottom-0 left-0 right-0 bg-surface-container-lowest border-t border-outline-variant px-margin-mobile py-space-md shadow-[0_-4px_10px_rgba(0,0,0,0.03)] z-20">
	<button id="place-order-btn" data-total={total} class="bg-primary-container text-on-primary px-space-lg py-3 rounded-default font-label-md text-label-md shadow-md hover:bg-primary transition-colors cursor-pointer w-full disabled:opacity-60 disabled:cursor-not-allowed">
		🍴 Place Order - CAD {total.toFixed(2)}  →
	</button>
</div>

<script>
	import { cart, loadCart } from "../stores/cartStore";

	const API_URL = "http://localhost:4000";

	const placeOrderBtn = document.querySelector<HTMLButtonElement>("#place-order-btn");
	const nameInput = document.querySelector<HTMLInputElement>("#customer-name-input");

	loadCart();

	placeOrderBtn?.addEventListener("click", async () => {
		const customerName = nameInput?.value.trim() ?? "";

		// Customer name is required
		if (!customerName) {
			alert("Please enter your name.");
			nameInput?.focus();
			return;
		}

		// Prevent double submit while the request is running
		placeOrderBtn.disabled = true;

		try {
			const res = await fetch(`${API_URL}/api/orders`, {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({
					customerName,
					items: cart.get(),
					totalAmount: Number(placeOrderBtn.dataset.total),
				}),
			});
			const data = await res.json();

			if (!res.ok || !data.success) {
				throw new Error(data.message || "Failed to place the order.");
			}

			alert(`Order placed! Order number: ${data.orderId}`);
			window.location.href = "/order-confirmation";
		} catch (error) {
			console.error("Error placing order:", error);
			alert("Could not place the order. Please try again.");
			placeOrderBtn.disabled = false;
		}
	});
</script>

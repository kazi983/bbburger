---
type Items = {
  quantity: number;
  name: string;
};

type Props = {
  orderID: number;
  customerName: string;
  status: number;
  //   items: Items[];
  createdAt: number;
};
const { orderID, customerName, status, createdAt } = Astro.props;
---

<div class="receivedCard">
  <hr class="cardBorder border-t-8 border-[#D62201]" />
  <div
    class="cardContainer bg-white p-5 shadow-lg hover:border-2 hover:border-[#D62201]"
  >
    <div class="grid grid-cols-2">
      <div>
        <p class="text-[#694300] font-bold">ORDER NUMBER</p>
        <p class="js-order-id text-[#A91A00] font-bold text-3xl">#{orderID}</p>
        <h2 class="js-customer-name font-bold">{customerName}</h2>
      </div>

      <div class="flex flex-col items-end">
        <div
          class="flex flex-row justify-center items-center gap-2 rounded-full bg-[#EBE0DB] py-1 px-4 w-fit"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="1em"
            height="1em"
            viewBox="0 0 24 24"
          >
            <path d="M0 0h24v24H0z" fill="none"></path>
            <g
              fill="none"
              stroke="#A91A00"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <path d="m15 16l-2.414-2.414A2 2 0 0 1 12 12.172V6"></path>
            </g>
          </svg>
          <p class="js-created-at">{createdAt} min ago</p>
        </div>

        <p
          class="js-status statusReceived bg-[#FFDAD3] rounded-full w-fit py-1 px-4 mt-2"
        >
          {status}
        </p>
      </div>
    </div>

    <hr class="my-4 border-t border-[#f4e2dc]" />

    <h3 class="text-[#694300] font-bold">ORDERED ITEMS</h3>
    <template class="js-items-template">
      <li class="mt-5">
        <span
          class="js-item-quantity bg-red-100 text-[#A91A00] w-2 h-2 rounded-full p-1"
          >2x</span
        >
        <span class="js-item-name"></span>
      </li>
    </template>

    <ul class="js-items-container"></ul>

    <hr class="my-4 border-t border-[#f4e2dc]" />

    <h3 class="mb-5 text-[#694300]">TRANSITION STATUS</h3>
    <div class="grid grid-cols-3 gap-5">
      <button
        type="button"
        class="prepareBtn flex flex-row gap-0.5 items-center justify-center bg-[#F7ECE7] text-[#694300] py-2 px-1 cursor-pointer"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1.1em"
          height="1.1em"
          viewBox="0 0 24 24"
        >
          <path d="M0 0h24v24H0z" fill="none"></path>
          <path
            fill="#694300"
            d="M5.483 10.616q.119-.824-.1-1.504T4.534 7.5q-.672-.98-.905-1.763q-.235-.78-.156-1.737h1.008q-.085.835.11 1.492q.196.658.828 1.589q.7 1.015.934 1.797t.138 1.738zm3.923 0q.119-.824-.096-1.504q-.216-.681-.848-1.612q-.671-.98-.908-1.762T7.396 4h1.008q-.085.835.11 1.492q.196.658.828 1.589q.7 1.015.934 1.797t.138 1.738zm4 0q.119-.824-.106-1.504T12.442 7.5q-.67-.98-.898-1.763T11.396 4h1.008q-.085.835.11 1.492q.196.658.828 1.589q.7 1.015.934 1.797t.138 1.738zM5 19q-.846 0-1.423-.577T3 17v-4h13.006q.028-.754.473-1.353t1.167-.836l4.202-1.415l.318.938l-4.203 1.416q-.434.139-.699.516q-.264.378-.264.838V17q0 .827-.577 1.414Q15.846 19 15 19zm0-1h10q.425 0 .713-.288T16 17v-3H4v3q0 .425.288.713T5 18m5-2"
          ></path>
        </svg>
        <span class="text-sm">Preparing</span>
      </button>

      <button
        type="button"
        disabled
        class="readyBtn flex flex-row gap-0.5 items-center justify-center bg-[#F7ECE7] py-2 px-1 text-[#694300] opacity-50 cursor-not-allowed"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1.1em"
          height="1.1em"
          viewBox="0 0 20 20"
          class="fill-current"
        >
          <path d="M0 0h20v20H0z" fill="none"></path>
          <path
            d="M14.5 9c0-2.524-1.976-4.5-4.5-4.5S5.5 6.476 5.5 9v4.5a.5.5 0 0 1-.146.353l-.647.647h10.586l-.646-.647a.5.5 0 0 1-.147-.353zm1 4.293l1.354 1.353a.5.5 0 0 1-.354.854h-13a.5.5 0 0 1-.354-.854L4.5 13.293V9c0-3.077 2.424-5.5 5.5-5.5s5.5 2.423 5.5 5.5z"
          ></path>
          <path
            d="M9.5 4V2.5a.5.5 0 0 1 1 0V4a.5.5 0 0 1-1 0M8 16.5a.5.5 0 0 1 1 0c0 .523.476 1 1 1s1-.477 1-1a.5.5 0 0 1 1 0c0 1.076-.924 2-2 2s-2-.924-2-2M6 1.572a.5.5 0 0 1 .5.865a7 7 0 0 0-3.078 3.668a.5.5 0 1 1-.94-.341A8 8 0 0 1 6 1.572m7.317.183A.5.5 0 0 1 14 1.572a8 8 0 0 1 3.518 4.191a.5.5 0 1 1-.94.342A7 7 0 0 0 13.5 2.437a.5.5 0 0 1-.183-.682"
          ></path>
        </svg>
        <span class="text-sm">Ready</span>
      </button>

      <button
        type="button"
        disabled
        class="completeBtn flex flex-row gap-0.5 items-center justify-center bg-[#F7ECE7] py-2 px-1 cursor-not-allowed text-[#694300] opacity-50"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1.1em"
          height="1.1em"
          viewBox="0 0 2048 2048"
          class="fill-current"
        >
          <path d="M0 0h2048v2048H0z" fill="none"></path>
          <path
            d="m1491 595l90 90l-749 749l-365-365l90-90l275 275zM1024 0q141 0 272 36t245 103t207 160t160 208t103 245t37 272q0 141-36 272t-103 245t-160 207t-208 160t-245 103t-272 37q-141 0-272-36t-245-103t-207-160t-160-208t-103-244t-37-273q0-141 36-272t103-245t160-207t208-160T751 37t273-37m0 1920q123 0 237-32t214-90t182-141t140-181t91-214t32-238q0-123-32-237t-90-214t-141-182t-181-140t-214-91t-238-32q-123 0-237 32t-214 90t-182 141t-140 181t-91 214t-32 238q0 123 32 237t90 214t141 182t181 140t214 91t238 32"
          ></path>
        </svg>
        <span class="text-sm">Complete</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { io } from "socket.io-client";

  const socket = io("http://localhost:3000");

  function sendStatusUpdate(status: string) {
    socket.emit("updated_status", status);
  }

  const cards = document.querySelectorAll(".receivedCard");

  cards.forEach((card) => {
    const prepBtn = card.querySelector(".prepareBtn") as HTMLButtonElement;
    const readyBtn = card.querySelector(".readyBtn") as HTMLButtonElement;
    const completeBtn = card.querySelector(".completeBtn") as HTMLButtonElement;
    const status = card.querySelector(".statusReceived");
    const border = card.querySelector(".cardBorder");
    const container = card.querySelector(".cardContainer");

    prepBtn?.addEventListener("click", () => {
      if (status && border && container && prepBtn) {
        status.textContent = "Preparing";
        status.classList.remove("bg-[#FFDAD3]");
        status.classList.add("bg-[#FFDDB4]");

        border.classList.remove("border-[#D62201]");
        border.classList.add("border-[#FFAA01]");

        container.classList.remove("hover:border-[#D62201]");
        container.classList.add("hover:border-[#FFAA01]");

        prepBtn.disabled = true;
        prepBtn.classList.add(
          "cursor-not-allowed",
          "bg-[#FFAA01]",
          "text-[#694300]",
        );

        readyBtn.disabled = false;
        readyBtn.classList.remove("opacity-50", "cursor-not-allowed");
        readyBtn.classList.add("cursor-pointer");
      }

      sendStatusUpdate("Preparing");
    });

    readyBtn?.addEventListener("click", () => {
      if (status && border && container && readyBtn && prepBtn) {
        status.textContent = "Ready";
        status.classList.remove("bg-[#FFDDB4]");
        status.classList.add("bg-[#88D982]");

        border.classList.remove("border-[#FFAA01]");
        border.classList.add("border-[#2E7D32]");

        container.classList.remove("hover:border-[#FFAA01]");
        container.classList.add("hover:border-[#2E7D32]");

        prepBtn.classList.remove("bg-[#FFAA01]", "cursor-pointer");
        prepBtn.classList.add(
          "bg-[#F7ECE7]",
          "opacity-50",
          "cursor-not-allowed",
        );

        readyBtn.disabled = true;
        readyBtn.classList.remove("bg-[#F7ECE7]", "text-[#694300]");
        readyBtn.classList.add(
          "cursor-not-allowed",
          "bg-[#2E7D32]",
          "text-white",
        );

        completeBtn.disabled = false;
        completeBtn.classList.remove("opacity-50", "cursor-not-allowed");
        completeBtn.classList.add("cursor-pointer");
      }

      sendStatusUpdate("Ready");
    });

    completeBtn?.addEventListener("click", () => {
      if (status && border && container && completeBtn && readyBtn) {
        status.textContent = "Complete";
        status.classList.remove("bg-[#88D982]");
        status.classList.add("bg-gray-200");

        border.classList.remove("border-[#2E7D32]");
        border.classList.add("border-black");

        container.classList.remove("hover:border-[#2E7D32]");
        container.classList.add("hover:border-black");

        readyBtn.classList.remove(
          "bg-[#2E7D32]",
          "text-white",
          "cursor-pointer",
        );
        readyBtn.classList.add(
          "bg-[#F7ECE7]",
          "text-[#694300]",
          "opacity-50",
          "cursor-not-allowed",
        );

        completeBtn.disabled = true;
        completeBtn.classList.add("bg-black", "text-white");
      }
    });
  });
</script>

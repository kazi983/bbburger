---
import type { OrderStatus } from "../lib/constant";

type Items = {
  quantity: number;
  name: string;
};

type Props = {
  orderID: number;
  customerName: string;
  status: OrderStatus;
  //   items: Items[];
  createdAt: number;
};
const { orderID, customerName, status, createdAt } = Astro.props;
---

<div class="receivedCard mb-8 md:mb-5">
  <hr class="cardBorder border-t-8 border-primary-container" />
  <div
    class="cardContainer bg-white p-5 shadow-lg hover:border-2 hover:border-primary-container"
  >
    <div class="grid grid-cols-2">
      <div>
        <p class="text-on-surface-variant font-bold">ORDER NUMBER</p>
        <p class="js-order-id text-primary font-bold text-3xl">#{orderID}</p>
        <h2 class="js-customer-name font-bold">{customerName}</h2>
      </div>

      <div class="flex flex-col items-end">
        <div
          class="flex flex-row justify-center items-center gap-2 rounded-full bg-surface-container-highest py-1 px-4 w-fit"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="1em"
            height="1em"
            viewBox="0 0 24 24"
          >
            <path d="M0 0h24v24H0z" fill="none"></path>
            <g
              fill="none"
              stroke="#A91A00"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <path d="m15 16l-2.414-2.414A2 2 0 0 1 12 12.172V6"></path>
            </g>
          </svg>
          <p class="js-ordered-at text-sm">{createdAt} min ago</p>
        </div>

        <p
          class="js-status statusReceived bg-error-container rounded-full w-fit py-1 px-4 mt-2"
        >
          {status}
        </p>
      </div>
    </div>

    <hr class="my-4 border-t border-outline-variant" />

    <h3 class="text-on-surface-variant font-bold">ORDERED ITEMS</h3>
    <template class="js-items-template">
      <li class="mt-5 flex items-center gap-2">
        <span
          class="js-item-quantity bg-red-100 text-primary w-5 h-5 rounded-full flex items-center justify-center text-label-md font-label-md"
          >2x</span
        >
        <span class="js-item-name"></span>
      </li>
    </template>

    <ul class="js-items-container"></ul>

    <hr class="my-4 border-t border-outline-variant" />

    <h3 class="mb-5 text-on-surface-variant">TRANSITION STATUS</h3>
    <div class="grid grid-cols-3 gap-5">
      <button
        type="button"
        class="prepareBtn flex flex-row gap-0.5 items-center justify-center bg-surface-container text-on-surface-variant py-2 px-1 cursor-pointer"
      >
        <span class="material-symbols-outlined text-[12px]">skillet</span>
        <span class="text-xs">Preparing</span>
      </button>

      <button
        type="button"
        disabled
        class="readyBtn flex flex-row gap-0.5 items-center justify-center bg-surface-container py-2 px-1 text-on-surface-variant opacity-50 cursor-not-allowed"
      >
        <span class="material-symbols-outlined text-[16px]"
          >notifications_active</span
        >
        <span class="text-xs">Ready</span>
      </button>

      <button
        type="button"
        disabled
        class="deliverBtn flex flex-row gap-0.5 items-center justify-center bg-surface-container py-2 px-1 cursor-not-allowed text-on-surface-variant opacity-50"
      >
        <span class="material-symbols-outlined text-[16px]">check_circle</span>
        <span class="text-xs">Delivered</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { socket } from "../lib/socket";

  function sendStatusUpdate(status: string) {
    socket.emit("updated_status", status);
  }

  const cards = document.querySelectorAll(".receivedCard");

  cards.forEach((card) => {
    const prepBtn = card.querySelector(".prepareBtn") as HTMLButtonElement;
    const readyBtn = card.querySelector(".readyBtn") as HTMLButtonElement;
    const deliverBtn = card.querySelector(".deliverBtn") as HTMLButtonElement;
    const status = card.querySelector(".statusReceived");
    const border = card.querySelector(".cardBorder");
    const container = card.querySelector(".cardContainer");

    prepBtn?.addEventListener("click", () => {
      if (status && border && container && prepBtn) {
        status.textContent = "Preparing";
        status.classList.remove("bg-bg-error-container");
        status.classList.add("bg-secondary-fixed");

        border.classList.remove("border-primary-container");
        border.classList.add("border-secondary-fixed-dim");

        container.classList.remove("hover:border-primary-container");
        container.classList.add("hover:border-secondary-fixed-dim");

        prepBtn.disabled = true;
        prepBtn.classList.remove("bg-surface-container", "cursor-pointer");
        prepBtn.classList.add("cursor-not-allowed", "bg-secondary-fixed-dim");

        readyBtn.disabled = false;
        readyBtn.classList.remove("opacity-50", "cursor-not-allowed");
        readyBtn.classList.add("cursor-pointer");
      }

      sendStatusUpdate("Preparing");
    });

    readyBtn?.addEventListener("click", () => {
      if (status && border && container && readyBtn && prepBtn) {
        status.textContent = "Ready";
        status.classList.remove("bg-secondary-fixed");
        status.classList.add("bg-tertiary-fixed-dim");

        border.classList.remove("border-secondary-fixed-dim");
        border.classList.add("border-tertiary-container");

        container.classList.remove("hover:border-[#FFAA01]");
        container.classList.add("hover:border-tertiary-container");

        prepBtn.classList.remove("cursor-pointer");
        prepBtn.classList.add("opacity-50", "cursor-not-allowed");

        readyBtn.disabled = true;
        readyBtn.classList.remove(
          "bg-surface-container",
          "text-on-surface-variant",
        );
        readyBtn.classList.add(
          "cursor-not-allowed",
          "bg-tertiary-container",
          "text-white",
        );

        deliverBtn.disabled = false;
        deliverBtn.classList.remove("opacity-50", "cursor-not-allowed");
        deliverBtn.classList.add("cursor-pointer");
      }

      sendStatusUpdate("Ready");
    });

    deliverBtn?.addEventListener("click", () => {
      if (status && border && container && deliverBtn && readyBtn) {
        status.textContent = "Delivered";
        status.classList.remove("bg-tertiary-fixed-dim");
        status.classList.add("bg-gray-200");

        border.classList.remove("border-tertiary-container");
        border.classList.add("border-black");

        container.classList.remove("hover:border-tertiary-container");
        container.classList.add("hover:border-black");

        readyBtn.classList.remove("cursor-pointer");
        readyBtn.classList.add("opacity-50", "cursor-not-allowed");

        deliverBtn.disabled = true;
        deliverBtn.classList.remove(
          "bg-surface-container",
          "text-on-surface-variant",
        );
        deliverBtn.classList.add("bg-black", "text-white");
      }
    });
  });
</script>

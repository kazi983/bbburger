<div class="receivedCard mb-8 md:mb-5">
  <hr class="cardBorder border-t-8 border-primary-container" />
  <div
    class="cardContainer bg-white p-5 shadow-lg hover:border-2 hover:border-primary-container"
  >
    <div class="grid grid-cols-2">
      <div>
        <p class="text-on-surface-variant font-bold">ORDER NUMBER</p>
        <p class="js-order-id text-primary font-bold text-3xl"></p>
        <h2 class="js-customer-name font-bold"></h2>
      </div>

      <div class="flex flex-col items-end">
        <div
          class="flex flex-row justify-center items-center gap-2 rounded-full bg-surface-container-highest py-1 px-4 w-fit"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="1em"
            height="1em"
            viewBox="0 0 24 24"
          >
            <path d="M0 0h24v24H0z" fill="none"></path>
            <g
              fill="none"
              stroke="#A91A00"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <path d="m15 16l-2.414-2.414A2 2 0 0 1 12 12.172V6"></path>
            </g>
          </svg>
          <p class="js-ordered-at text-sm"></p>
        </div>

        <p
          class="js-status statusReceived bg-error-container rounded-full w-fit py-1 px-4 mt-2"
        >
        </p>
      </div>
    </div>

    <hr class="my-4 border-t border-outline-variant" />

    <h3 class="text-on-surface-variant font-bold">ORDERED ITEMS</h3>
    <template class="js-items-template">
      <li class="mt-5 flex items-center gap-2">
        <span
          class="js-item-quantity bg-red-100 text-primary w-5 h-5 rounded-full flex items-center justify-center text-label-md font-label-md"
          >2x</span
        >
        <span class="js-item-name"></span>
      </li>
    </template>

    <ul class="js-items-container"></ul>

    <hr class="my-4 border-t border-outline-variant" />

    <h3 class="mb-5 text-on-surface-variant">TRANSITION STATUS</h3>
    <div class="grid grid-cols-3 gap-5">
      <button
        type="button"
        class="prepareBtn flex flex-row gap-0.5 items-center justify-center bg-surface-container text-on-surface-variant py-2 px-1 cursor-pointer"
      >
        <span class="material-symbols-outlined text-[12px]">skillet</span>
        <span class="text-xs">Preparing</span>
      </button>

      <button
        type="button"
        disabled
        class="readyBtn flex flex-row gap-0.5 items-center justify-center bg-surface-container py-2 px-1 text-on-surface-variant opacity-50 cursor-not-allowed"
      >
        <span class="material-symbols-outlined text-[16px]"
          >notifications_active</span
        >
        <span class="text-xs">Ready</span>
      </button>

      <button
        type="button"
        disabled
        class="deliverBtn flex flex-row gap-0.5 items-center justify-center bg-surface-container py-2 px-1 cursor-not-allowed text-on-surface-variant opacity-50"
      >
        <span class="material-symbols-outlined text-[16px]">check_circle</span>
        <span class="text-xs">Delivered</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { sendStatusUpdate } from "../lib/order";
  import { showErrorToast } from "../lib/toast";

  // Returns true only when the server accepted the new status
  async function updateStatus(orderId: number, status: string) {
    try {
      await sendStatusUpdate(orderId, status);
      return true;
    } catch (err) {
      console.error("Failed to update order status:", err);
      const reason = err instanceof Error ? err.message : String(err);
      showErrorToast(`Order #${orderId}: could not set "${status}". ${reason}`);
      return false;
    }
  }

  // Event delegation: cards are cloned from a <template> and rebuilt on every
  // socket update, so a single listener on document handles all of them.
  document.addEventListener("click", async (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>(
      ".prepareBtn, .readyBtn, .deliverBtn",
    );
    if (!btn || btn.disabled) return;

    const card = btn.closest<HTMLElement>(".receivedCard");
    if (!card) return;

    const prepBtn = card.querySelector<HTMLButtonElement>(".prepareBtn");
    const readyBtn = card.querySelector<HTMLButtonElement>(".readyBtn");
    const deliverBtn = card.querySelector<HTMLButtonElement>(".deliverBtn");
    if (!prepBtn || !readyBtn || !deliverBtn) return;

    const orderId = Number(card.dataset.orderId);
    const nextStatus =
      btn === prepBtn ? "Preparing" : btn === readyBtn ? "Ready" : "Delivered";

    // Update the UI only after the server accepts the change.
    // Disable the button while waiting to prevent double submits.
    btn.disabled = true;
    const ok = await updateStatus(orderId, nextStatus);
    if (!ok) {
      btn.disabled = false;
    }
  });
</script>

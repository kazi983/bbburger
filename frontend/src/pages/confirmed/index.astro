---
import Layout from "../../layouts/layout.astro";
import OrderConfirm from "../../components/OrderConfirm.astro";
import Header from "../../components/Header.astro";
import BottomNavBar from "../../components/BottomNavBar.astro";
---

<Layout title="BBB - Order Confirmation">
	<Header title="Order Confirmation"/>
	<div class="text-on-background font-body pb-28 p-10">
		<!-- The real order number and name are filled in from sessionStorage -->
		<OrderConfirm />
		<div class="flex justify-end">
			<a
            href="/home"
            class="mt-6 inline-block rounded-full bg-primary-container px-6 py-3 font-semibold text-on-primary-container hover:bg-primary "
          >
            Go back to home →
          </a>
		</div>
		
	<BottomNavBar active="tracking" />
	</div>
	
</Layout>

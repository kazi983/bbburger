---
import Layout from "../../layouts/layout.astro";
import ReceivedOrderCard from "../../components/ReceivedOrderCard.astro";
import FinishedOrderCard from "../../components/FinishedOrderCard.astro";
import { OrderStatus } from "../../lib/constant";
---

<Layout title="Kitchen Dashboard">
  <main class="pt-20">
    <div class="bg-white p-3 shadow-lg">
      <div class="lg:grid lg:grid-cols-2">
        <h1 class="text-4xl font-bold mt-5 mb-8">Kitchen Operation</h1>

        <div class="grid grid-cols-4 gap-2 mb-5">
          <button
            id="receivedBtn"
            class="flex flex-col items-center bg-[#F7ECE7] p-2 border border-[#f3cabc] cursor-pointer"
          >
            <h2 class="text-[#5D403A] text-sm">RECEIVED</h2>
            <p class="text-3xl font-bold text-[#A91A00]">1</p>
          </button>

          <button
            class="flex flex-col items-center bg-[#F7ECE7] p-2 border border-[#f3cabc] cursor-pointer"
          >
            <h2 class="text-[#5D403A] text-sm">PREPARING</h2>
            <p class="text-3xl font-bold text-[#FFAA00]">1</p>
          </button>

          <button
            class="flex flex-col items-center bg-[#F7ECE7] p-2 border border-[#f3cabc] cursor-pointer"
          >
            <h2 class="text-[#5D403A] text-sm">READY</h2>
            <p class="text-3xl font-bold text-[#0B631B]">1</p>
          </button>

          <button
            class="flex flex-col items-center bg-[#F7ECE7] p-2 border border-[#f3cabc] cursor-pointer"
          >
            <h2 class="text-[#5D403A] text-sm">DONE</h2>
            <p class="text-3xl font-bold text-black">1</p>
          </button>
        </div>
      </div>

      <hr class="my-4 border-t border-[#f4e2dc]" />

      <div class="flex flex-row items-center justify-end sm:gap-1">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 24 24"
        >
          <path d="M0 0h24v24H0z" fill="none"></path>
          <path
            fill="none"
            stroke="#0B631B"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 16H5v5m9-13h5V3M4.583 9.003a8 8 0 0 1 14.331-1.027m.504 7.021a8 8 0 0 1-14.332 1.027"
          ></path>
        </svg>

        <span class="text-[#5D403A] text-xs">Auto-refreshing (1s) </span>
      </div>
    </div>

    <h2 class="text-2xl font-bold my-10">
      <span class="h-3 w-3 animate-pulse bg-[#D62201] rounded-full inline-block"
      ></span> Received Orders
    </h2>

    <template id="receivedCardTemplate">
      <ReceivedOrderCard
        orderID={0}
        customerName=""
        status={OrderStatus.Received}
        createdAt={0}
      />
    </template>

    <div
      id="receivedOrdersContainer"
      class="md:gap-4 md:grid lg:grid md:grid-cols-2 lg:grid-cols-3"
    >
    </div>

    <h2 class="text-2xl font-bold my-10">
      <span
        class="h-3
    w-3
    animate-pulse
    bg-[#0B631B]
    rounded-full
    inline-block"
      >
      </span> Finished Orders
    </h2>

    <div
      class="hidden md:grid md:grid-cols-6 md:items-center md:gap-2 md:p-5 md:bg-[#f6d1c0] md:font-bold"
    >
      <h3>ORDER #</h3>
      <h3>STATUS</h3>
      <h3>CUSTOMER</h3>
      <h3>ITEM SUMMARY</h3>
      <h3>COMPLETED AT</h3>
      <h3>TOTAL</h3>
    </div>
    <div id="finishedOrdersContainer"></div>

    <template id="finishedOrdersTemplate">
      <FinishedOrderCard orderID={0} customerName="" completedAt="" total="" />
    </template>
  </main>
</Layout>

<script>
  import { $orders } from "../../stores/order";
  import type { Order } from "../../../../shared/types";

  const receivedCardTemplate = document.querySelector<HTMLTemplateElement>(
    "#receivedCardTemplate",
  );
  const finishedOrdersTemplate = document.querySelector<HTMLTemplateElement>(
    "#finishedOrdersTemplate",
  );
  const receivedOrdersContainer = document.getElementById(
    "receivedOrdersContainer",
  );
  const finishedOrdersContainer = document.getElementById(
    "finishedOrdersContainer",
  );

  function setText(root: ParentNode, selector: string, text: string) {
    root.querySelector(selector)!.textContent = text;
  }

  function formatMinutesAgo(orderedAt: number) {
    const rtf = new Intl.RelativeTimeFormat("en", { numeric: "auto" });
    const diffMinutes = Math.floor((Date.now() - orderedAt) / 60_000);

    if (diffMinutes === 0) return "Just now";
    else return rtf.format(-diffMinutes, "minute");
  }

  function renderOrders(orders: readonly Order[]) {
    if (!receivedCardTemplate || !finishedOrdersTemplate) return;
    receivedOrdersContainer?.replaceChildren();
    finishedOrdersContainer?.replaceChildren();

    orders.forEach((order) => {
      if (order.status === "Delivered") {
        // render finished orders

        const cloneCard = finishedOrdersTemplate.content.cloneNode(
          true,
        ) as DocumentFragment;

        setText(cloneCard, ".js-order-id", `#${order.orderId}`);
        setText(cloneCard, ".js-customer-name", order.customerName);
        setText(cloneCard, ".js-total", `CAD ${order.total.toFixed(2)}`);

        const itemStr = order.items
          .map((item) => `${item.quantity}x ${item.productName}`)
          .join(", ");
        setText(cloneCard, ".js-items", itemStr);

        if (order.completedAt) {
          const completedTimeStr = new Date(
            order.completedAt,
          ).toLocaleTimeString("en-US", {
            // TODO: Are we gonna show only today's orders?
            hour: "numeric",
            minute: "2-digit",
          });
          setText(cloneCard, ".js-completed-at", completedTimeStr);
        }

        finishedOrdersContainer?.appendChild(cloneCard);
      } else {
        // render on-going orders

        const cloneCard = receivedCardTemplate.content.cloneNode(
          true,
        ) as DocumentFragment;

        setText(cloneCard, ".js-order-id", `#${order.orderId}`);
        setText(cloneCard, ".js-customer-name", order.customerName);
        setText(cloneCard, ".js-status", order.status);
        setText(cloneCard, ".js-ordered-at", formatMinutesAgo(order.orderedAt));

        // Keep the raw timestamp on the element for periodic re-rendering
        cloneCard.querySelector<HTMLElement>(
          ".js-ordered-at",
        )!.dataset.orderedAt = String(order.orderedAt);

        const itemsTemplate =
          cloneCard.querySelector<HTMLTemplateElement>(".js-items-template")!;
        const itemsContainer = cloneCard.querySelector(".js-items-container")!;

        order.items.forEach((item) => {
          const cloneItemList = itemsTemplate.content.cloneNode(
            true,
          ) as HTMLElement;

          setText(cloneItemList, ".js-item-quantity", `${item.quantity}x`);
          setText(cloneItemList, ".js-item-name", item.productName);

          itemsContainer.appendChild(cloneItemList);
        });

        receivedOrdersContainer?.appendChild(cloneCard);
      }
    });
  }

  // update only the elapsed-time labels every 30 seconds
  setInterval(() => {
    document
      .querySelectorAll<HTMLElement>(".js-ordered-at[data-ordered-at]")
      .forEach((el) => {
        el.textContent = formatMinutesAgo(Number(el.dataset.orderedAt));
      });
  }, 30_000);

  $orders.subscribe(renderOrders);

  // ==========================================================================
  // STUB

  const testOrders: Order[] = [
    {
      orderId: 123,
      customerName: "Fernanda",
      status: "Received",
      orderedAt: new Date("2026/10/14 17:55").getTime(),
      total: 50,
      items: [
        {
          productId: 1,
          unitPrice: 1,
          productName: "Double Flame Burger",
          quantity: 2,
        },
        { productId: 1, unitPrice: 1, productName: "Mega Fries", quantity: 3 },
        {
          productId: 1,
          unitPrice: 1,
          productName: "Strawberry Milkshake",
          quantity: 1,
        },
      ],
    },
    {
      orderId: 456,
      customerName: "Kazi",
      status: "Received",
      orderedAt: new Date("2026/10/14 18:00").getTime(),
      total: 50,
      items: [
        {
          productId: 1,
          unitPrice: 1,
          productName: "Double Flame Burger",
          quantity: 2,
        },
        { productId: 1, unitPrice: 1, productName: "Mega Fries", quantity: 3 },
        {
          productId: 1,
          unitPrice: 1,
          productName: "Strawberry Milkshake",
          quantity: 1,
        },
      ],
    },
    {
      orderId: 888,
      customerName: "Kazi",
      status: "Received",
      orderedAt: Date.now(),
      total: 50,
      items: [
        {
          productId: 1,
          unitPrice: 1,
          productName: "Double Flame Burger",
          quantity: 2,
        },
        { productId: 1, unitPrice: 1, productName: "Mega Fries", quantity: 3 },
        {
          productId: 1,
          unitPrice: 1,
          productName: "Strawberry Milkshake",
          quantity: 1,
        },
      ],
    },
    {
      orderId: 789,
      customerName: "Kazi",
      status: "Delivered",
      orderedAt: 2,
      completedAt: Date.now(),
      total: 50,
      items: [
        {
          productId: 1,
          unitPrice: 1,
          productName: "Cheese Flame Burger",
          quantity: 2,
        },
        { productId: 1, unitPrice: 1, productName: "Mega Fries", quantity: 10 },
        {
          productId: 1,
          unitPrice: 1,
          productName: "Vanila Milkshake",
          quantity: 1,
        },
      ],
    },
    {
      orderId: 190,
      customerName: "Kazi",
      status: "Delivered",
      orderedAt: 2,
      completedAt: Date.now(),
      total: 50,
      items: [
        {
          productId: 1,
          unitPrice: 1,
          productName: "Cheese Flame Burger",
          quantity: 2,
        },
        { productId: 1, unitPrice: 1, productName: "Mega Fries", quantity: 10 },
        {
          productId: 1,
          unitPrice: 1,
          productName: "Vanila Milkshake",
          quantity: 1,
        },
      ],
    },
  ];

  testOrders.forEach((order) => {
    $orders.set([...$orders.get(), order]);
  });

  // ==========================================================================
</script>

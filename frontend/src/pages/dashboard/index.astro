---
import Layout from "../../layouts/layout.astro";
import ReceivedOrderCard from "../../components/ReceivedOrderCard.astro";
import FinishedOrderCard from "../../components/FinishedOrderCard.astro";
import { OrderStatus } from "../../lib/constant";
---

<Layout title="Kitchen Dashboard">
  <header
    class="top-0 flex items-center justify-between gap-3 bg-background/95 backdrop-blur-sm p-5"
  >
    <div
      class="flex min-w-0 items-center gap-2 text-base font-bold text-primary sm:text-2xl"
    >
      <span
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-container text-on-primary-container"
        aria-hidden="true"
      >
        <span class="material-symbols-outlined fill-icon">
          local_fire_department
        </span>
      </span>

      <span class="font-bold text-primary sm:text-2xl">Awshaf BBB</span>
    </div>
    <button
      id="logout-button"
      type="button"
      class="rounded-lg bg-primary-container px-4 py-2 font-bold text-on-primary-container"
      hidden
    >
      Log Out
    </button>
  </header>

  <main id="dashboard" class="pt-5 px-5 pb-10" hidden>
    <div class="bg-white p-3 shadow-lg">
      <div class="lg:grid lg:grid-cols-2">
        <h1 class="text-4xl font-bold mt-5 mb-8">Kitchen Operation</h1>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-5">
          <div
            class="flex flex-col items-center bg-surface-container-low p-2 border border-outline-variant"
          >
            <h2 class="text-on-surface-variant text-xs font-bold">RECEIVED</h2>
            <p id="receivedCounter" class="text-3xl font-bold text-primary">
              1
            </p>
          </div>

          <div
            class="flex flex-col items-center bg-surface-container-low p-2 border border-outline-variant"
          >
            <h2 class="text-on-surface-variant text-xs font-bold">PREPARING</h2>
            <p
              id="preparingCounter"
              class="text-3xl font-bold text-secondary-container"
            >
              1
            </p>
          </div>

          <div
            class="flex flex-col items-center bg-surface-container-low p-2 border border-outline-variant"
          >
            <h2 class="text-on-surface-variant text-xs font-bold">READY</h2>
            <p id="readyCounter" class="text-3xl font-bold text-tertiary">1</p>
          </div>

          <div
            class="flex flex-col items-center bg-surface-container-low p-2 border border-outline-variant"
          >
            <h2 class="text-on-surface-variant text-xs font-bold">DELIVERED</h2>
            <p id="deliveredCounter" class="text-3xl font-bold text-black">1</p>
          </div>
        </div>
      </div>
    </div>

    <h2 class="text-2xl font-bold my-10">
      <span
        class="h-3 w-3 animate-pulse bg-primary-container rounded-full inline-block"
      ></span> Received Orders
    </h2>

    <template id="receivedCardTemplate">
      <ReceivedOrderCard
        orderID={0}
        customerName=""
        status={OrderStatus.Received}
        createdAt={0}
      />
    </template>

    <div
      id="receivedOrdersContainer"
      class="md:gap-4 md:grid lg:grid md:grid-cols-2 lg:grid-cols-3"
    >
    </div>

    <h2 class="text-2xl font-bold my-10">
      <span
        class="h-3
    w-3
    animate-pulse
    bg-tertiary
    rounded-full
    inline-block"
      >
      </span> Finished Orders
    </h2>

    <div
      class="hidden md:grid md:grid-cols-6 md:items-center md:gap-2 md:p-5 md:bg-surface-variant md:font-bold"
    >
      <h3>ORDER #</h3>
      <h3>STATUS</h3>
      <h3>CUSTOMER</h3>
      <h3>ITEM SUMMARY</h3>
      <h3>COMPLETED AT</h3>
      <h3>TOTAL</h3>
    </div>
    <div id="finishedOrdersContainer"></div>

    <template id="finishedOrdersTemplate">
      <FinishedOrderCard orderID={0} customerName="" completedAt="" total="" />
    </template>
  </main>

  <div
    id="error-toast"
    role="alert"
    aria-atomic="true"
    class="pointer-events-none fixed top-24 left-1/2 z-60 w-max max-w-[calc(100vw-32px)] -translate-x-1/2 -translate-y-2 rounded-xl bg-error px-5 py-3 text-center text-sm text-on-error opacity-0 shadow-lg transition duration-200 motion-reduce:transition-none"
  >
  </div>
</Layout>

<script>
  import { socket } from "../../lib/socket";
  import type { Order } from "../../../../shared/types";
  import { fetchOrders } from "../../lib/order";
  import { getMe, logout } from "../../lib/auth";
  import { showErrorToast } from "../../lib/toast";

  const logoutButton =
    document.querySelector<HTMLButtonElement>("#logout-button");

  function showDashboard() {
    document.getElementById("dashboard")!.hidden = false;

    if (logoutButton) {
      logoutButton.hidden = false;
    }
  }

  // On page load: check the existing session
  const me = await getMe();
  if (me) showDashboard();
  else window.location.href = "/login";

  // Render orders
  logoutButton?.addEventListener("click", async () => {
    try {
      await logout();
      window.location.href = "/login";
    } catch (error) {
      console.error("Logout failed.", error);
      showErrorToast("Logout failed. Please try again.");
    }
  });

  const receivedCounter = document.getElementById("receivedCounter");
  const preparingCounter = document.getElementById("preparingCounter");
  const readyCounter = document.getElementById("readyCounter");
  const deliveredCounter = document.getElementById("deliveredCounter");
  const receivedCardTemplate = document.querySelector<HTMLTemplateElement>(
    "#receivedCardTemplate",
  );
  const finishedOrdersTemplate = document.querySelector<HTMLTemplateElement>(
    "#finishedOrdersTemplate",
  );
  const receivedOrdersContainer = document.getElementById(
    "receivedOrdersContainer",
  );
  const finishedOrdersContainer = document.getElementById(
    "finishedOrdersContainer",
  );

  function setText(root: ParentNode, selector: string, text: string) {
    const elem = root.querySelector(selector);
    if (elem) elem.textContent = text;
  }

  function updateCounters(orders: Order[]) {
    const receivedCount = orders.filter(
      (order) => order.status === "Received",
    ).length;
    const preparingCount = orders.filter(
      (order) => order.status === "Preparing",
    ).length;
    const readyCount = orders.filter(
      (order) => order.status === "Ready",
    ).length;
    const deliveredCount = orders.filter(
      (order) => order.status === "Delivered",
    ).length;

    if (receivedCounter) receivedCounter.textContent = String(receivedCount);
    if (preparingCounter) preparingCounter.textContent = String(preparingCount);
    if (readyCounter) readyCounter.textContent = String(readyCount);
    if (deliveredCounter) deliveredCounter.textContent = String(deliveredCount);
  }

  function formatMinutesAgo(orderedAt: number) {
    const rtf = new Intl.RelativeTimeFormat("en", {
      numeric: "auto",
      style: "short",
    });
    const diffMinutes = Math.floor((Date.now() - orderedAt) / 60_000);

    if (diffMinutes === 0) return "Just now";
    else return rtf.format(-diffMinutes, "minute");
  }

  function renderOrders(orders: Order[]) {
    if (!receivedCardTemplate || !finishedOrdersTemplate) return;
    receivedOrdersContainer?.replaceChildren();
    finishedOrdersContainer?.replaceChildren();

    orders.forEach((order) => {
      if (order.status === "Delivered") {
        // render finished orders

        const cloneCard = finishedOrdersTemplate.content.cloneNode(
          true,
        ) as DocumentFragment;

        setText(cloneCard, ".js-order-id", `#${order.orderId}`);
        setText(cloneCard, ".js-customer-name", order.customerName);
        setText(cloneCard, ".js-total", `CAD ${order.total.toFixed(2)}`);

        const itemStr = order.items
          .map((item) => `${item.quantity}x ${item.productName}`)
          .join(", ");
        setText(cloneCard, ".js-items", itemStr);

        if (order.completedAt) {
          const completedTimeStr = new Date(
            order.completedAt,
          ).toLocaleTimeString("en-US", {
            // TODO: Are we gonna show only today's orders?
            hour: "numeric",
            minute: "2-digit",
          });
          setText(cloneCard, ".js-completed-at", completedTimeStr);
        }

        finishedOrdersContainer?.appendChild(cloneCard);
      } else {
        // render on-going orders

        const cloneCard = receivedCardTemplate.content.cloneNode(
          true,
        ) as DocumentFragment;

        // Store the order ID on the card root so event handlers can read it
        const cardElem = cloneCard.querySelector<HTMLElement>(".receivedCard");
        if (cardElem) cardElem.dataset.orderId = String(order.orderId);

        setText(cloneCard, ".js-order-id", `#${order.orderId}`);
        setText(cloneCard, ".js-customer-name", order.customerName);
        setText(cloneCard, ".js-status", order.status);
        setText(cloneCard, ".js-ordered-at", formatMinutesAgo(order.orderedAt));

        // Keep the raw timestamp on the element for periodic re-rendering
        const orderedAtElem =
          cloneCard.querySelector<HTMLElement>(".js-ordered-at");
        if (orderedAtElem)
          orderedAtElem.dataset.orderedAt = String(order.orderedAt);

        const itemsTemplate =
          cloneCard.querySelector<HTMLTemplateElement>(".js-items-template")!;
        const itemsContainer = cloneCard.querySelector(".js-items-container")!;

        order.items.forEach((item) => {
          const cloneItemList = itemsTemplate.content.cloneNode(
            true,
          ) as HTMLElement;

          setText(cloneItemList, ".js-item-quantity", `${item.quantity}x`);
          setText(cloneItemList, ".js-item-name", item.productName);

          itemsContainer.appendChild(cloneItemList);
        });

        receivedOrdersContainer?.appendChild(cloneCard);
      }
    });
  }

  // update only the elapsed-time labels every 30 seconds
  setInterval(() => {
    document
      .querySelectorAll<HTMLElement>(".js-ordered-at[data-ordered-at]")
      .forEach((el) => {
        el.textContent = formatMinutesAgo(Number(el.dataset.orderedAt));
      });
  }, 30_000);

  socket.on("connect", async () => {
    try {
      const orders = await fetchOrders();
      renderOrders(orders);
      updateCounters(orders);
    } catch (err) {
      console.error("Failed to fetch orders:", err);
      showErrorToast("Failed to load orders. Please reload the page.");
    }
  });

  socket.on("connect_error", () => {
    showErrorToast("Cannot connect to the server. Retrying...");
  });

  socket.on("new_order", (orders: Order[]) => {
    renderOrders(orders);
    updateCounters(orders);
  });

  socket.on("status_updated", (orders: Order[]) => {
    renderOrders(orders);
    updateCounters(orders);
  });
</script>

---
import Layout from "../../layouts/layout.astro";
import ReceivedOrderCard from "../../components/ReceivedOrderCard.astro";
import FinishedOrderCard from "../../components/FinishedOrderCard.astro";
import { OrderStatus } from "../../lib/constant";
---

<Layout title="Kitchen Dashboard">
  <main class="pt-20">
    <div class="bg-white p-3 shadow-lg">
      <div class="lg:grid lg:grid-cols-2">
        <h1 class="text-4xl font-bold mt-5 mb-8">Kitchen Operation</h1>

        <div class="grid grid-cols-4 gap-2 mb-5">
          <button
            id="receivedBtn"
            class="flex flex-col items-center bg-[#F7ECE7] p-2 border border-[#f3cabc] cursor-pointer"
          >
            <h2 class="text-[#5D403A] text-sm">RECEIVED</h2>
            <p class="text-3xl font-bold text-[#A91A00]">1</p>
          </button>

          <button
            class="flex flex-col items-center bg-[#F7ECE7] p-2 border border-[#f3cabc] cursor-pointer"
          >
            <h2 class="text-[#5D403A] text-sm">PREPARING</h2>
            <p class="text-3xl font-bold text-[#FFAA00]">1</p>
          </button>

          <button
            class="flex flex-col items-center bg-[#F7ECE7] p-2 border border-[#f3cabc] cursor-pointer"
          >
            <h2 class="text-[#5D403A] text-sm">READY</h2>
            <p class="text-3xl font-bold text-[#0B631B]">1</p>
          </button>

          <button
            class="flex flex-col items-center bg-[#F7ECE7] p-2 border border-[#f3cabc] cursor-pointer"
          >
            <h2 class="text-[#5D403A] text-sm">DONE</h2>
            <p class="text-3xl font-bold text-black">1</p>
          </button>
        </div>
      </div>

      <hr class="my-4 border-t border-[#f4e2dc]" />

      <div class="flex flex-row items-center justify-end sm:gap-1">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 24 24"
        >
          <path d="M0 0h24v24H0z" fill="none"></path>
          <path
            fill="none"
            stroke="#0B631B"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 16H5v5m9-13h5V3M4.583 9.003a8 8 0 0 1 14.331-1.027m.504 7.021a8 8 0 0 1-14.332 1.027"
          ></path>
        </svg>

        <span class="text-[#5D403A] text-xs">Auto-refreshing (1s) </span>
      </div>
    </div>

    <h2 class="text-2xl font-bold my-10">
      <span class="h-3 w-3 animate-pulse bg-[#D62201] rounded-full inline-block"
      ></span> Received Orders
    </h2>

    <template id="receivedCardTemplate">
      <ReceivedOrderCard
        orderID={0}
        ,
        customerName=""
        ,
        status={OrderStatus.Received}
        createdAt={0}
      />
    </template>

    <div
      id="recievedOrdersContainer"
      class="md:gap-4 md:grid lg:grid md:grid-cols-2 lg:grid-cols-3"
    >
    </div>

    <h2 class="text-2xl font-bold my-10">
      <span
        class="h-3
    w-3
    animate-pulse
    bg-[#0B631B]
    rounded-full
    inline-block"
      >
      </span> Finished Orders
    </h2>

    <div
      class="hidden md:grid md:grid-cols-6 md:items-center md:gap-2 md:p-5 md:bg-[#f6d1c0] md:font-bold"
    >
      <h3>ORDER #</h3>
      <h3>STATUS</h3>
      <h3>CUSTOMER</h3>
      <h3>ITEM SUMMARY</h3>
      <h3>COMPLETED AT</h3>
      <h3>TOTAL</h3>
    </div>finishedOrdersContainer
    <div id="finishedOrdersContainer"></div>

    <template id="finishedOrdersTemplate">
    <FinishedOrderCard
        orderID={0}
      ,
        customerName=""
      ,
        completedAt=""
      ,
        total=""
    />
    </template>

    <!-- ========================================================================== -->
    <!-- STUB -->
    <FinishedOrderCard
      orderID={456}
      ,
      customerName="John Wallace"
      ,
      completedAt="4:00pm"
      ,
      total="16.20"
    />
    <!-- ========================================================================== -->
  </main>
</Layout>

<script>
  import { OrderStatus } from "../../lib/constant";
  import { $orders, type Order } from "../../stores/order";

  const receivedCardTemplate = document.getElementById("receivedCardTemplate");
  const finishedOrdersTemplate = document.getElementById(
    "finishedOrdersTemplate",
  );
  const recievedOrdersContainer = document.getElementById(
    "recievedOrdersContainer",
  );
  const finishedOrdersContainer = document.getElementById(
    "finishedOrdersContainer",
  );

  function renderOrders(orders: Order[]) {
    orders.map((order) => {
      if (!receivedCardTemplate || !finishedOrdersTemplate) return;
      if (order.status === OrderStatus.Completed) {
        // TODO render finished orders
      } else {
        // render on-going orders
        const cloneCard = receivedCardTemplate.content.cloneNode(true);

        cloneCard.querySelector(".js-order-id").textContent = order.orderId;
        cloneCard.querySelector(".js-customer-name").textContent =
          order.customerName;
        cloneCard.querySelector(".js-status").textContent = order.status;

        const itemsTemplate = cloneCard.querySelector(".js-items-template");

        order.items?.forEach((item) => {
          const cloneItemList = itemsTemplate.content.cloneNode(true);

          cloneItemList.querySelector(".js-item-quantity").textContent =
            `${item.quantity}x`;
          cloneItemList.querySelector(".js-item-name").textContent =
            item.productName;

          cloneCard
            .querySelector(".js-items-container")
            ?.appendChild(cloneItemList);
        });

        recievedOrdersContainer?.appendChild(cloneCard);
      }
    });
  }

  $orders.subscribe((orders) => renderOrders(orders));

  // ==========================================================================
  // STUB

  const testOrders = [
    {
      orderId: 123,
      customerName: "Fernanda",
      status: OrderStatus.Received,
      createdAt: 4,
      items: [
        { productName: "Double Flame Burger", quantity: 2 },
        { productName: "Mega Fries", quantity: 3 },
        { productName: "Strawberry Milkshake", quantity: 1 },
      ],
    },
    {
      orderId: 456,
      customerName: "Kazi",
      status: OrderStatus.Received,
      createdAt: 2,
      items: [
        { productName: "Cheese Flame Burger", quantity: 2 },
        { productName: "Mega Fries", quantity: 10 },
        { productName: "Vanila Milkshake", quantity: 1 },
      ],
    },
  ];

  renderOrders(testOrders);

  // ==========================================================================
</script>

---
import Layout from "../../layouts/layout.astro";
import Header from "../../components/Header.astro";
import BottomNavBar from "../../components/BottomNavBar.astro";
import "../../styles/tracking.css";
---

<Layout title="Order Status">
  <Header title="Order Status" />

  <main class="mx-auto max-w-md space-y-6 px-4 py-6 pb-28 pt-20">
    <!-- Live Order Card -->
    <section
      class="animate-card-enter space-y-6 rounded-3xl bg-white p-5 shadow-sm"
    >
      <!-- Order Header -->
      <div class="flex items-center justify-between">
        <div
          class="flex items-center gap-2 rounded-full bg-orange-50 px-3 py-2"
        >
          <span class="material-symbols-outlined text-primary">
            storefront
          </span>
          <span class="text-sm font-bold text-primary"> Counter Pickup </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="animate-status-pulse h-2 w-2 rounded-full bg-tertiary"
          ></span>
          <span id="statusOrder" class="text-sm font-semibold text-tertiary">
            In Progress
          </span>
        </div>
      </div>

      <!-- Order Number -->
      <div>
        <p id="order-number" class="text-sm text-on-surface-variant">Order #</p>

        <h2 class="mt-2 font-headline text-2xl font-bold text-on-surface">
          Est. Ready in
          <span class="text-primary">~6 mins</span>
        </h2>
      </div>

      <!-- Progress Steps -->
      <div class="grid grid-cols-3 gap-3">
        <!-- Received -->
        <div class="space-y-2">
          <div class="flex h-8 items-center">
            <div
              class="flex h-7 w-7 items-center justify-center rounded-full bg-tertiary text-white"
            >
              <span class="material-symbols-outlined text-lg"> check </span>
            </div>
            <!-- <div id="prepBar" class="ml-2 h-1 flex-1 rounded-full bg-primary">
            </div> -->

            <div
              class="ml-2 h-1 flex-1 overflow-hidden rounded-full bg-surface-container-high"
            >
              <div
                id="prepBar"
                class="animate-progress-enter h-full rounded-full bg-primary"
              >
              </div>
            </div>
          </div>

          <p class="text-sm font-bold text-tertiary">Received</p>
        </div>

        <!-- Preparing -->
        <div class="space-y-2">
          <div class="flex h-8 items-center">
            <div
              id="prepIcon"
              class="flex h-7 w-7 items-center justify-center rounded-full bg-primary text-white"
            >
              <span
                class="animate-flame-pulse material-symbols-outlined text-lg"
              >
                local_fire_department
              </span>
            </div>

            <div
              class="ml-2 h-1 flex-1 overflow-hidden rounded-full bg-surface-container-high"
            >
              <div
                id="readyBar"
                class="hidden animate-progress-enter h-full rounded-full bg-primary"
              >
              </div>
            </div>
          </div>

          <p id="prepText" class="text-sm font-bold text-primary">Preparing</p>
        </div>

        <!-- Ready -->
        <div class="space-y-2">
          <div class="flex h-8 items-center">
            <div
              id="readyIcon"
              class="flex h-7 w-7 items-center justify-center rounded-full bg-surface-container text-on-surface-variant"
            >
              <span class="material-symbols-outlined text-lg">
                shopping_bag
              </span>
            </div>
          </div>

          <p
            id="readyText"
            class="text-sm font-semibold text-on-surface-variant"
          >
            Ready
          </p>
        </div>
      </div>

      <!-- Current Stage -->

      <!-- Stage 1 -->
      <div id="stage1" class="rounded-2xl bg-surface-container-low p-4">
        <div class="flex items-start gap-3">
          <div
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-tertiary text-white"
          >
            <span class="animate-flame-pulse material-symbols-outlined">
              check
            </span>
          </div>

          <div class="flex-1">
            <div class="flex items-center gap-2">
              <h3 class="font-headline font-bold text-on-surface">
                Stage 1: Yay, we received your order!
              </h3>

              <span
                class="animate-status-pulse h-2 w-2 shrink-0 rounded-full bg-tertiary"
              ></span>
            </div>

            <p class="mt-2 text-sm leading-6 text-on-surface-variant">
              Thank you for ordering our delicious BBB! Your food will be
              prepared soon.
            </p>
          </div>
        </div>
      </div>

      <!-- stage 2 -->
      <div id="stage2" class="hidden rounded-2xl bg-surface-container-low p-4">
        <div class="flex items-start gap-3">
          <div
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-tertiary text-white"
          >
            <span class="animate-flame-pulse material-symbols-outlined">
              local_fire_department
            </span>
          </div>

          <div class="flex-1">
            <div class="flex items-center gap-2">
              <h3 class="font-headline font-bold text-on-surface">
                Stage 2: Fresh on the Grill
              </h3>

              <span
                class="animate-status-pulse h-2 w-2 shrink-0 rounded-full bg-tertiary"
              ></span>
            </div>

            <p class="mt-2 text-sm leading-6 text-on-surface-variant">
              The kitchen is preparing your BBB order fresh right now.
            </p>
          </div>
        </div>
      </div>

      <!-- stage 3 -->
      <div id="stage3" class="hidden rounded-2xl bg-surface-container-low p-4">
        <div class="flex items-start gap-3">
          <div
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-tertiary text-white"
          >
            <span class="animate-flame-pulse material-symbols-outlined">
              shopping_bag
            </span>
          </div>

          <div class="flex-1">
            <div class="flex items-center gap-2">
              <h3 class="font-headline font-bold text-on-surface">
                Stage 3: Go! Go! Go!
              </h3>

              <span
                class="animate-status-pulse h-2 w-2 shrink-0 rounded-full bg-tertiary"
              ></span>
            </div>

            <p class="mt-2 text-sm leading-6 text-on-surface-variant">
              Your delicious BBB is ready!!! Enjoy your meal and see you soon.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Order Summary -->
    <section class="space-y-4 rounded-3xl bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <h2 class="font-headline text-xl font-bold text-on-surface">
          Order Summary
        </h2>

        <span
          id="order-item-count"
          class="rounded-full bg-surface-container px-3 py-1 text-xs font-bold text-on-surface-variant"
        >
          Order Items (0)
        </span>
      </div>

      <!-- Order Items -->
      <div id="order-items"></div>

      <!-- Total -->
      <div class="flex items-center justify-between pt-1">
        <div>
          <p class="font-bold text-on-surface">Total</p>
        </div>

        <p
          id="order-total"
          class="font-headline text-2xl font-bold text-primary"
        >
          CAD 0.00
        </p>
      </div>
    </section>
  </main>

  <BottomNavBar active="order" />

  <script>
    import { socket } from "../../lib/socket";

    const statusOrder = document.getElementById("statusOrder");

    const prepStatus = document.getElementById("prepText");
    const prepBar = document.getElementById("prepBar");
    const prepIcon = document.getElementById("prepIcon");

    const readyStatus = document.getElementById("readyText");
    const readyBar = document.getElementById("readyBar");
    const readyIcon = document.getElementById("readyIcon");

    const stage1 = document.getElementById("stage1");
    const stage2 = document.getElementById("stage2");
    const stage3 = document.getElementById("stage3");

    socket.on("new_status", (status: string) => {
      if (status === "Preparing") {
        if (
          prepStatus &&
          prepBar &&
          prepIcon &&
          readyBar &&
          readyIcon &&
          readyStatus &&
          stage1 &&
          stage2
        ) {
          prepStatus.classList.remove("text-primary");
          prepStatus.classList.add("text-tertiary");

          prepBar.classList.remove("animate-progress-enter", "bg-primary");
          prepBar.classList.add("animate-progress-final", "bg-tertiary");

          prepIcon.classList.remove("bg-primary");
          prepIcon.classList.add("bg-tertiary");

          readyBar.classList.remove("hidden");

          readyIcon.classList.remove(
            "bg-surface-container",
            "text-on-surface-variant",
          );
          readyIcon.classList.add("bg-primary", "text-white");

          readyStatus.classList.remove("text-on-surface-variant");
          readyStatus.classList.add("text-primary");

          stage1.classList.add("hidden");
          stage2.classList.remove("hidden");
        }
      }

      if (status === "Ready") {
        if (
          statusOrder &&
          readyStatus &&
          readyBar &&
          readyIcon &&
          stage2 &&
          stage3
        ) {
          statusOrder.textContent = "Completed";

          readyStatus.classList.remove("text-primary");
          readyStatus.classList.add("text-tertiary");

          readyBar.classList.remove("animate-progress-enter", "bg-primary");
          readyBar.classList.add("animate-progress-final", "bg-tertiary");

          readyIcon.classList.remove("bg-primary");

          readyIcon.classList.add("bg-tertiary");
          stage2.classList.add("hidden");
          stage3.classList.remove("hidden");
        }
      }
    });
  </script>
</Layout>
<script>
  const API_URL = import.meta.env.PUBLIC_API_URL;

  // Get the order number from the URL
  const params = new URLSearchParams(window.location.search);
  const orderNum = params.get("orderNum");

  // Get HTML elements
  const orderNumber = document.getElementById("order-number");
  const orderItemCount = document.getElementById("order-item-count");
  const orderItems = document.getElementById("order-items");
  const orderTotal = document.getElementById("order-total");

  async function loadOrder() {
    try {
      // Fetch order data from the backend
      const response = await fetch(`${API_URL}/orders/${orderNum}`);
      const order = await response.json();

      if (!response.ok) {
        throw new Error(order.message || "Order not found.");
      }

      // Display order information
      if (orderNumber) {
        orderNumber.textContent = `Order #${order.orderId}`;
      }

      if (orderItemCount) {
        orderItemCount.textContent = `Order Items (${order.items.length})`;
      }

      if (orderItems) {
        orderItems.innerHTML = order.items
          .map(
            (item: {
              productName: string;
              quantity: number;
              unitPrice: number;
            }) => `
              <div class="flex items-start justify-between gap-4 border-b border-outline-variant/40 pb-4">
                <div class="flex gap-3">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-surface-container text-sm font-bold text-on-surface">
                    ${item.quantity}x
                  </span>
                  <h3 class="font-semibold text-on-surface">
                    ${item.productName}
                  </h3>
                </div>
                <p class="shrink-0 font-semibold text-on-surface">
                  CAD ${(item.unitPrice * item.quantity).toFixed(2)}
                </p>
              </div>
            `,
          )
          .join("");
      }

      if (orderTotal) {
        orderTotal.textContent = `CAD ${Number(order.total).toFixed(2)}`;
      }
    } catch (error) {
      if (orderNumber) {
        orderNumber.textContent =
          error instanceof Error ? error.message : "Unable to load order.";
      }
    }
  }

  loadOrder();
</script>

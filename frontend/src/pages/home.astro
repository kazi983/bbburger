---
import "../styles/global.css";
import BottomNav from "../components/BottomNav.astro";
import products from "../../../backend/data/product.json";

const categories = [
  { value: "all", label: "All" },
  { value: "burguer", label: "Burgers" },
  { value: "fries", label: "Fries" },
  { value: "drink", label: "Drinks" },
  { value: "desert", label: "Desserts" },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Menu | Awshaf BBB</title>
  </head>

  <body class="min-h-screen bg-orange-50 pb-24 text-stone-900">
    <div class="mx-auto max-w-6xl px-4 py-6">
      <header class="mb-8 flex items-center justify-between gap-3">
        <a href="/home" class="text-xl font-bold text-red-700">
          Awshaf BBB
        </a>

        <a
          href="/cart"
          class="cart-button inline-flex shrink-0 items-center gap-2 rounded-full bg-red-600 px-5 py-3 font-bold text-white shadow-md transition-colors hover:bg-red-700"
        >
          <svg
            class="cart-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 3h2l3 12h11l2-8H6" />
            <circle cx="9" cy="20" r="1" />
            <circle cx="18" cy="20" r="1" />
          </svg>

          Cart

          <span
            id="cart-count"
            class="rounded-full bg-white px-2 py-0.5 text-sm text-red-700"
          >
            0
          </span>
        </a>
      </header>

      <main>
        <section class="rounded-3xl bg-white p-6 shadow-sm sm:p-10">
          <p
            class="mb-4 inline-block rounded-full bg-amber-400 px-3 py-1 text-xs font-semibold"
          >
            FLAME-BROILED PERFECTION
          </p>

          <h1 class="max-w-lg text-4xl font-bold leading-tight sm:text-5xl">
            Craving Pure
            <span class="block text-red-700">Flame Power?</span>
          </h1>

          <p class="mt-4 max-w-md leading-relaxed text-stone-600">
            Sizzle up your day with fresh 100% Angus patties seared on open
            flames, crispy golden fries, and chef-crafted smoky house dips.
          </p>

          <a
            href="#menu"
            class="mt-6 inline-block rounded-full bg-red-600 px-6 py-3 font-semibold text-white hover:bg-red-700"
          >
            Explore the Menu →
          </a>

          <p class="mt-4 text-sm font-medium text-green-800">
            15 Min Express Pickup
          </p>
        </section>

        <section id="menu" class="mt-10">
          <h2 class="text-2xl font-bold">Craveable Menu</h2>

          <p class="mt-1 text-sm text-stone-600">
            Handcrafted, fresh off the grill
          </p>

          <div
            id="category-filters"
            class="mt-5 flex flex-wrap gap-2"
            role="group"
            aria-label="Filter menu by category"
          >
            {
              categories.map((category) => (
                <button
                  type="button"
                  data-category={category.value}
                  aria-pressed={category.value === "all" ? "true" : "false"}
                  class="rounded-full border border-stone-300 bg-white px-4 py-2 text-sm font-semibold hover:border-stone-900 aria-pressed:bg-stone-900 aria-pressed:text-white"
                >
                  {category.label}
                </button>
              ))
            }
          </div>

          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {
              products.map((product) => (
                <article
                  data-product-category={product.category}
                  class="flex flex-col rounded-2xl bg-white p-5 shadow-sm"
                >
                  <p class="mb-3 text-xs font-semibold uppercase text-red-700">
                    {
                      categories.find(
                        (category) => category.value === product.category
                      )?.label ?? product.category
                    }
                  </p>

                  <h3 class="text-lg font-bold">{product.name}</h3>

                  <p class="mt-2 text-sm text-stone-600">
                    {product.description}
                  </p>

                  {
                    product.ingredients.length > 0 && (
                      <p class="mt-3 text-sm text-stone-500">
                        {product.ingredients.join(", ")}
                      </p>
                    )
                  }

                  <div class="mt-auto flex items-center justify-between gap-3 pt-5">
                    <div>
                      <p class="text-xs text-stone-500">Price</p>

                      <p class="text-xl font-bold text-red-700">
                        ${product.price.toFixed(2)}
                      </p>
                    </div>

                    <button
                      type="button"
                      data-add-product={product.id}
                      aria-label={`Add ${product.name} to cart`}
                      class="rounded-full bg-red-600 px-5 py-2 font-semibold text-white hover:bg-red-700"
                    >
                      + Add
                    </button>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <p
          id="cart-message"
          role="status"
          class="mt-4 min-h-6 text-sm text-green-800"
        ></p>

        <aside
          id="cart-summary"
          class="mt-6 hidden rounded-2xl bg-stone-900 p-4 text-white shadow-lg"
          aria-label="Cart summary"
        >
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="min-w-0 flex-1">
              <p id="cart-total" class="font-bold"></p>

              <p
                id="cart-names"
                class="mt-1 break-words text-sm text-stone-300"
              ></p>
            </div>

            <a
              href="/cart"
              class="shrink-0 rounded-full bg-red-600 px-4 py-3 text-sm font-semibold hover:bg-red-700"
            >
              View Order →
            </a>
          </div>
        </aside>
      </main>
    </div>

    <BottomNav />
  </body>
</html>

<script>
  import products from "../../../backend/data/product.json";
  import { cart, loadCart, addToCart } from "../stores/cartStore";

  const filterButtons = document.querySelectorAll<HTMLButtonElement>(
    "#category-filters button"
  );

  const productCards = document.querySelectorAll<HTMLElement>(
    "[data-product-category]"
  );

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const category = button.dataset.category;

      filterButtons.forEach((filterButton) => {
        filterButton.setAttribute(
          "aria-pressed",
          String(filterButton === button)
        );
      });

      productCards.forEach((card) => {
        const matchesCategory =
          category === "all" ||
          card.dataset.productCategory === category;

        card.classList.toggle("hidden", !matchesCategory);
      });
    });
  });

  const cartCount = document.querySelector("#cart-count");
  const cartSummary = document.querySelector("#cart-summary");
  const cartTotal = document.querySelector("#cart-total");
  const cartNames = document.querySelector("#cart-names");
  const cartMessage = document.querySelector("#cart-message");

  function updateCartSummary() {
    let count = 0;
    let totalCents = 0;
    const names: string[] = [];

    cart.get().forEach((item) => {
      const product = products.find(
        (product) => product.id === item.productId
      );

      if (!product) return;

      count += item.quantity;
      totalCents += Math.round(product.price * 100) * item.quantity;
      names.push(`${product.name} × ${item.quantity}`);
    });

    if (cartCount) {
      cartCount.textContent = String(count);
    }

    if (cartTotal) {
      cartTotal.textContent =
        `${count} ${count === 1 ? "item" : "items"} · ` +
        `$${(totalCents / 100).toFixed(2)}`;
    }

    if (cartNames) {
      cartNames.textContent = names.join(", ");
    }

    cartSummary?.classList.toggle("hidden", count === 0);
  }

  loadCart();
  cart.subscribe(updateCartSummary);

  const addButtons = document.querySelectorAll<HTMLButtonElement>(
    "[data-add-product]"
  );

  addButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const productId = Number(button.dataset.addProduct);
      const product = products.find(
        (product) => product.id === productId
      );

      if (!product) return;

      addToCart(productId);

      if (cartMessage) {
        cartMessage.textContent = `${product.name} added to cart.`;
      }
    });
  });
</script>


  <style>
  .cart-icon {
    animation: cart-roll 2s ease-in-out infinite;
  }

  @keyframes cart-roll {
    0%, 100% {
      transform: translateX(0) rotate(0deg);
    }

    30% {
      transform: translateX(3px) rotate(-8deg);
    }

    60% {
      transform: translateX(-2px) rotate(5deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-icon {
      animation: none;
    }
  }
</style>
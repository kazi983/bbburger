---
import Layout from "../layouts/layout.astro";
import BottomNavBar from "../components/BottomNavBar.astro";
import ProductGallery from "../components/ProductGallery.astro";
import products from "../../../backend/data/product.json";

const categories = [
  { value: "all", label: "All" },
  { value: "burguer", label: "Burgers" },
  { value: "fries", label: "Fries" },
  { value: "drink", label: "Drinks" },
  { value: "desert", label: "Desserts" },
];

const productImages: Record<number, string[]> = {
  1: [
    "/images/aussie-burger.jpg",
    "/images/aussie-burger-2.jpg",
    "/images/aussie-burger-3.jpg",
  ],
  2: [
    "/images/kofta-burger.png",
    "/images/kofta-burger-2.jpg",
  ],
  3: [
    "/images/lamb-burger.png",
    "/images/lamb-burger-2.jpg",
  ],
  4: [
    "/images/yuca-fries.png",
    "/images/yuca-fries-2.jpg",
  ],
  5: [
    "/images/french-fries.png",
    "/images/french-fries-2.jpg",
  ],
  6: ["/images/coke.jpg"],
  7: ["/images/strawberry-milkshake.jpg"],
  8: ["/images/chocolate-cake.jpg"],
  9: ["/images/diet-coke.jpg"],
};

const currency = new Intl.NumberFormat("en-CA", {
  style: "currency",
  currency: "CAD",
  currencyDisplay: "code",
});
---

<Layout title="Menu | Awshaf BBB">
  <div class="mx-auto max-w-6xl px-4 pt-6 pb-28">
    <header class="mb-8 flex items-center justify-between gap-3">
      <a href="/home" class="text-xl font-bold text-primary">
        Awshaf BBB
      </a>

      <a
        href="/cart"
        class="inline-flex shrink-0 items-center gap-2 rounded-full bg-primary-container px-4 py-3 font-bold text-on-primary-container shadow-md transition-colors hover:bg-primary"
      >
        <svg
          class="cart-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 3h2l3 12h11l2-8H6" />
          <circle cx="9" cy="20" r="1" />
          <circle cx="18" cy="20" r="1" />
        </svg>

        Cart

        <span
          id="cart-count"
          class="rounded-full bg-surface-container-lowest px-2 py-0.5 text-sm text-primary"
        >
          0
        </span>
      </a>
    </header>

    <main>
      <section
        class="grid items-center gap-8 overflow-hidden rounded-3xl bg-surface-container-lowest p-6 shadow-sm sm:p-10 md:grid-cols-2"
      >
        <div>
          <p
            class="mb-4 inline-block rounded-full bg-secondary-container px-3 py-1 text-xs font-semibold text-on-secondary-container"
          >
            FLAME-BROILED PERFECTION
          </p>

          <h1 class="font-headline text-4xl font-bold leading-tight sm:text-5xl">
            Craving Pure
            <span class="block text-primary">Flame Power?</span>
          </h1>

          <p class="mt-4 max-w-md leading-relaxed text-on-surface-variant">
            Sizzle up your day with fresh 100% Angus patties seared on open
            flames, crispy golden fries, and chef-crafted smoky house dips.
          </p>

          <a
            href="#menu"
            class="mt-6 inline-block rounded-full bg-primary-container px-6 py-3 font-semibold text-on-primary-container hover:bg-primary"
          >
            Explore the Menu →
          </a>

          <p class="mt-4 text-sm font-medium text-tertiary">
            15 Min Express Pickup
          </p>
        </div>

        <img
          src="/images/hero-burger.jpg"
          alt="Burger promotion"
          class="h-64 w-full rounded-2xl object-cover sm:h-80"
          fetchpriority="high"
        />
      </section>

      <section id="menu" class="mt-10">
        <h2 class="font-headline text-2xl font-bold">Craveable Menu</h2>

        <p class="mt-1 text-sm text-on-surface-variant">
          Handcrafted, fresh off the grill
        </p>

        <div
          id="category-filters"
          class="mt-5 flex flex-wrap gap-2"
          role="group"
          aria-label="Filter menu by category"
        >
          {
            categories.map((category) => (
              <button
                type="button"
                data-category={category.value}
                aria-pressed={category.value === "all" ? "true" : "false"}
                class="rounded-full border border-outline-variant bg-surface-container-lowest px-4 py-2 text-sm font-semibold hover:border-primary aria-pressed:bg-inverse-surface aria-pressed:text-inverse-on-surface"
              >
                {category.label}
              </button>
            ))
          }
        </div>

        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            products.map((product) => (
              <article
                data-product-category={product.category}
                class="flex flex-col overflow-hidden rounded-2xl bg-surface-container-lowest shadow-sm"
              >
                <ProductGallery
                  name={product.name}
                  images={productImages[product.id]}
                />

                <div class="flex flex-1 flex-col p-5">
                  <p class="mb-3 text-xs font-semibold uppercase text-primary">
                    {
                      categories.find(
                        (category) => category.value === product.category
                      )?.label ?? product.category
                    }
                  </p>

                  <h3 class="font-headline text-lg font-bold">
                    {product.name}
                  </h3>

                  <p class="mt-2 text-sm text-on-surface-variant">
                    {product.description}
                  </p>

                  {
                    product.ingredients.length > 0 && (
                      <p class="mt-3 text-sm text-on-surface-variant">
                        {product.ingredients.join(", ")}
                      </p>
                    )
                  }

                  <div class="mt-auto flex items-center justify-between gap-3 pt-5">
                    <div>
                      <p class="text-xs text-on-surface-variant">Price</p>

                      <p class="text-lg font-bold text-primary">
                        {currency.format(product.price)}
                      </p>
                    </div>

                    <button
                      type="button"
                      data-add-product={product.id}
                      aria-label={`Add ${product.name} to cart`}
                      class="shrink-0 rounded-full bg-primary-container px-5 py-2 font-semibold text-on-primary-container hover:bg-primary"
                    >
                      + Add
                    </button>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <p
        id="cart-message"
        role="status"
        class="mt-4 min-h-6 text-sm text-tertiary"
      ></p>

      <aside
        id="cart-summary"
        class="mt-6 hidden rounded-2xl bg-inverse-surface p-4 text-inverse-on-surface shadow-lg"
        aria-label="Cart summary"
      >
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="min-w-0 flex-1">
            <p id="cart-total" class="font-bold"></p>

            <p
              id="cart-names"
              class="mt-1 break-words text-sm"
            ></p>
          </div>

          <a
            href="/cart"
            class="shrink-0 rounded-full bg-primary-container px-4 py-3 text-sm font-semibold text-on-primary-container hover:bg-primary"
          >
            View Order →
          </a>
        </div>
      </aside>
    </main>
  </div>

  <BottomNavBar active="menu" />
</Layout>

<script>
  import products from "../../../backend/data/product.json";
  import { cart, loadCart, addToCart } from "../stores/cartStore";

  const currency = new Intl.NumberFormat("en-CA", {
    style: "currency",
    currency: "CAD",
    currencyDisplay: "code",
  });

  const filterButtons = document.querySelectorAll<HTMLButtonElement>(
    "#category-filters button"
  );

  const productCards = document.querySelectorAll<HTMLElement>(
    "[data-product-category]"
  );

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const category = button.dataset.category;

      filterButtons.forEach((filterButton) => {
        filterButton.setAttribute(
          "aria-pressed",
          String(filterButton === button)
        );
      });

      productCards.forEach((card) => {
        const matchesCategory =
          category === "all" ||
          card.dataset.productCategory === category;

        card.style.display = matchesCategory ? "flex" : "none";
      });
    });
  });

  const cartCount = document.querySelector("#cart-count");
  const cartSummary = document.querySelector("#cart-summary");
  const cartTotal = document.querySelector("#cart-total");
  const cartNames = document.querySelector("#cart-names");
  const cartMessage = document.querySelector("#cart-message");

  function updateCartSummary() {
    let count = 0;
    let totalCents = 0;
    const names: string[] = [];

    cart.get().forEach((item) => {
      const product = products.find(
        (product) => product.id === item.productId
      );

      if (!product) return;

      count += item.quantity;
      totalCents += Math.round(product.price * 100) * item.quantity;
      names.push(`${product.name} × ${item.quantity}`);
    });

    if (cartCount) {
      cartCount.textContent = String(count);
    }

    if (cartTotal) {
      cartTotal.textContent =
        `${count} ${count === 1 ? "item" : "items"} · ` +
        currency.format(totalCents / 100);
    }

    if (cartNames) {
      cartNames.textContent = names.join(", ");
    }

    cartSummary?.classList.toggle("hidden", count === 0);
  }

  loadCart();
  cart.subscribe(updateCartSummary);

  const addButtons = document.querySelectorAll<HTMLButtonElement>(
    "[data-add-product]"
  );

  addButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const productId = Number(button.dataset.addProduct);
      const product = products.find(
        (product) => product.id === productId
      );

      if (!product) return;

      addToCart(productId);

      if (cartMessage) {
        cartMessage.textContent = `${product.name} added to cart.`;
      }
    });
  });
</script>

<style>
  .cart-icon {
    animation: cart-roll 2s ease-in-out infinite;
  }

  @keyframes cart-roll {
    0%, 100% {
      transform: translateX(0) rotate(0deg);
    }

    30% {
      transform: translateX(3px) rotate(-8deg);
    }

    60% {
      transform: translateX(-2px) rotate(5deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-icon {
      animation: none;
    }
  }
</style>
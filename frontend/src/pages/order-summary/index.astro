---
import Layout from "../../layouts/layout.astro";
import CartHeader from "../../components/CartHeader.astro";
import CustomerForm from "../../components/CustomerForm.astro";
import Payment from "../../components/Payment.astro";
import PlaceOrderButton from "../../components/PlaceOrderButton.astro";
---

<Layout title="BBB - Order Summary">
  <div class="font-body text-on-background">
    <CartHeader />

    <main class="mx-auto max-w-xl space-y-5 px-4 pt-5 pb-10">
      <div class="flex items-center justify-between gap-3">
        <h1 class="font-headline text-xl font-bold">Items Ordered</h1>

        <a href="/menu" class="text-sm font-bold text-primary">
          + Add More
        </a>
      </div>

      <p id="cart-item-count" class="text-sm text-on-surface-variant"></p>

      <div
        id="empty-cart"
        class="rounded-2xl bg-surface-container-lowest p-6 text-center"
      >
        <p>Your cart is empty.</p>

        <a
          href="/menu"
          class="mt-4 inline-block rounded-full bg-primary-container px-5 py-3 font-semibold text-on-primary-container"
        >
          Browse Menu
        </a>
      </div>

      <ul id="cart-list" class="space-y-4"></ul>

      <p
        id="quantity-message"
        role="status"
        class="text-sm text-tertiary"
      ></p>

      <div id="checkout-details" class="hidden space-y-5">
        <CustomerForm />
        <Payment subtotal={0} tax={0} total={0} />
        <PlaceOrderButton />
      </div>
    </main>
  </div>
</Layout>

<script>
  import products from "../../../../backend/data/product.json";
  import {
    cart,
    loadCart,
    updateCartItem,
    removeCartItem,
  } from "../../stores/cartStore";

  const productImages: Record<number, string> = {
    1: "/images/aussie-burger.jpg",
    2: "/images/kofta-burger.png",
    3: "/images/lamb-burger.png",
    4: "/images/yuca-fries.png",
    5: "/images/french-fries.png",
    6: "/images/coke.jpg",
    7: "/images/strawberry-milkshake.jpg",
    8: "/images/chocolate-cake.jpg",
    9: "/images/diet-coke.jpg",
  };

  const currency = new Intl.NumberFormat("en-CA", {
    style: "currency",
    currency: "CAD",
    currencyDisplay: "code",
  });

  const cartList = document.querySelector("#cart-list");
  const itemCount = document.querySelector("#cart-item-count");
  const emptyCart = document.querySelector("#empty-cart");
  const checkoutDetails = document.querySelector("#checkout-details");
  const quantityMessage = document.querySelector("#quantity-message");

  function makeButton(
    text: string,
    label: string,
    itemKey: string,
    action: string
  ) {
    const button = document.createElement("button");
    button.type = "button";
    button.textContent = text;
    button.setAttribute("aria-label", label);
    button.dataset.itemKey = itemKey;
    button.dataset.action = action;
    button.className =
      "flex h-10 min-w-10 items-center justify-center rounded-full " +
      "border border-outline-variant px-3 font-bold text-primary " +
      "hover:bg-surface-container";

    return button;
  }

  function renderCart() {
    if (!cartList) return;

    const focusedButton =
      document.activeElement instanceof HTMLButtonElement &&
      cartList.contains(document.activeElement)
        ? document.activeElement
        : null;

    const focusedKey = focusedButton?.dataset.itemKey;
    const focusedAction = focusedButton?.dataset.action;

    cartList.replaceChildren();

    let count = 0;
    let subtotalCents = 0;

    cart.get().forEach((item) => {
      const product = products.find(
        (product) => product.id === item.productId
      );

      if (!product) return;

      const itemTotalCents =
        Math.round(product.price * 100) * item.quantity;

      count += item.quantity;
      subtotalCents += itemTotalCents;

      const row = document.createElement("li");
      row.className =
        "flex gap-4 rounded-2xl border border-outline-variant " +
        "bg-surface-container-lowest p-4";

      const image = document.createElement("img");
      image.src = productImages[product.id];
      image.alt = product.name;
      image.className = "h-20 w-20 shrink-0 rounded-xl object-cover";

      const details = document.createElement("div");
      details.className = "min-w-0 flex-1";

      const name = document.createElement("h2");
      name.className = "font-bold";
      name.textContent = product.name;

      const unitPrice = document.createElement("p");
      unitPrice.className = "mt-1 text-sm text-on-surface-variant";
      unitPrice.textContent = `Unit: ${currency.format(product.price)}`;

      details.append(name, unitPrice);

      const optionLabels: string[] = [];

      if (item.options.doneness) {
        optionLabels.push(`Cooked: ${item.options.doneness}`);
      }

      item.options.removedIngredients.forEach((ingredient) => {
        optionLabels.push(`No ${ingredient}`);
      });

      if (optionLabels.length > 0) {
        const optionsList = document.createElement("ul");
        optionsList.className =
          "mt-2 space-y-1 rounded-lg bg-surface-container p-2 " +
          "text-xs text-on-surface-variant";

        optionLabels.forEach((label) => {
          const option = document.createElement("li");
          option.textContent = label;
          optionsList.append(option);
        });

        details.append(optionsList);
      }

      const total = document.createElement("p");
      total.className = "mt-2 font-bold text-primary";
      total.textContent = currency.format(itemTotalCents / 100);

      const controls = document.createElement("div");
      controls.className = "mt-3 flex flex-wrap items-center gap-2";

      const quantity = document.createElement("span");
      quantity.textContent = String(item.quantity);
      quantity.className = "min-w-6 text-center font-semibold";
      quantity.setAttribute("aria-label", `Quantity: ${item.quantity}`);

      const itemDescription = [
        product.name,
        ...optionLabels,
      ].join(", ");

      controls.append(
        makeButton(
          "−",
          `Decrease quantity of ${itemDescription}`,
          item.key,
          "decrease"
        ),
        quantity,
        makeButton(
          "+",
          `Increase quantity of ${itemDescription}`,
          item.key,
          "increase"
        ),
        makeButton(
          "Remove",
          `Remove ${itemDescription}`,
          item.key,
          "remove"
        )
      );

      details.append(total, controls);
      row.append(image, details);
      cartList.append(row);
    });

    if (itemCount) {
      itemCount.textContent =
        `${count} ${count === 1 ? "item" : "items"}`;
    }

    emptyCart?.classList.toggle("hidden", count > 0);
    checkoutDetails?.classList.toggle("hidden", count === 0);

    // Matches the team's provisional 8% estimate.
    const taxCents = Math.round(subtotalCents * 0.08);
    const totalCents = subtotalCents + taxCents;

    const amounts = [
      ["#subtotal-amount", subtotalCents],
      ["#tax-amount", taxCents],
      ["#total-amount", totalCents],
    ] as const;

    amounts.forEach(([selector, cents]) => {
      const element = document.querySelector(selector);

      if (element) {
        element.textContent = currency.format(cents / 100);
      }
    });

    if (focusedKey && focusedAction) {
      const replacement = Array.from(
        cartList.querySelectorAll<HTMLButtonElement>("button")
      ).find(
        (button) =>
          button.dataset.itemKey === focusedKey &&
          button.dataset.action === focusedAction
      );

      if (replacement) {
        replacement.focus();
      } else {
        document.querySelector<HTMLAnchorElement>(
          'main a[href="/menu"]'
        )?.focus();
      }
    }
  }

  cartList?.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Element)) return;

    const button = target.closest<HTMLButtonElement>(
      "button[data-action]"
    );

    if (!button) return;

    const itemKey = button.dataset.itemKey;
    const item = cart.get().find(
      (item) => item.key === itemKey
    );

    if (!item) return;

    if (button.dataset.action === "increase") {
      updateCartItem(item.key, item.quantity + 1);
    } else if (button.dataset.action === "decrease") {
      updateCartItem(item.key, item.quantity - 1);
    } else if (button.dataset.action === "remove") {
      removeCartItem(item.key);
    }

    if (quantityMessage) {
      quantityMessage.textContent = "Cart updated.";
    }
  });

  loadCart();
  cart.subscribe(renderCart);
</script>
---
import Layout from "../layouts/layout.astro";
import Header from "../components/Header.astro";
import BottomNavBar from "../components/BottomNavBar.astro";
import "../styles/tracking.css";
---

<Layout title="Order Status">
  <Header title="Order Status" />

  <main class="mx-auto max-w-md space-y-6 px-4 py-6 pb-28 pt-20">
    <!-- Live Order Card -->
    <section
      class="animate-card-enter space-y-6 rounded-3xl bg-white p-5 shadow-sm"
    >
      <!-- Order Header -->
      <div class="flex items-center justify-between">
        <div
          class="flex items-center gap-2 rounded-full bg-orange-50 px-3 py-2"
        >
          <span class="material-symbols-outlined text-primary">
            storefront
          </span>
          <span class="text-sm font-bold text-primary"> Counter Pickup </span>
        </div>

        <div class="flex items-center gap-2">
          <span class="animate-status-pulse h-2 w-2 rounded-full bg-tertiary"
          ></span>
          <span class="text-sm font-semibold text-tertiary"> In Progress </span>
        </div>
      </div>

      <!-- Order Number -->
      <div>
        <p id = order-number  class="text-sm text-on-surface-variant">Order #</p>

        <h2 class="mt-2 font-headline text-2xl font-bold text-on-surface">
          Est. Ready in
          <span class="text-primary">~6 mins</span>
        </h2>
      </div>

      <!-- Progress Steps -->
      <div class="grid grid-cols-3 gap-3">
        <!-- Received -->
        <div class="space-y-2">
          <div class="flex h-8 items-center">
            <div
              class="flex h-7 w-7 items-center justify-center rounded-full bg-tertiary text-white"
            >
              <span class="material-symbols-outlined text-lg"> check </span>
            </div>
            <div class="ml-2 h-1 flex-1 rounded-full bg-tertiary"></div>
          </div>

          <p class="text-sm font-bold text-tertiary">Received</p>
        </div>

        <!-- Preparing -->
        <div class="space-y-2">
          <div class="flex h-8 items-center">
            <div
              class="flex h-7 w-7 items-center justify-center rounded-full bg-primary text-white"
            >
              <span
                class="animate-flame-pulse material-symbols-outlined text-lg"
              >
                local_fire_department
              </span>
            </div>

            <div
              class="ml-2 h-1 flex-1 overflow-hidden rounded-full bg-surface-container-high"
            >
              <div
                class="animate-progress-enter h-full rounded-full bg-primary"
              >
              </div>
            </div>
          </div>

          <p class="text-sm font-bold text-primary">Preparing</p>
        </div>

        <!-- Ready -->
        <div class="space-y-2">
          <div class="flex h-8 items-center">
            <div
              class="flex h-7 w-7 items-center justify-center rounded-full bg-surface-container text-on-surface-variant"
            >
              <span class="material-symbols-outlined text-lg">
                shopping_bag
              </span>
            </div>
          </div>

          <p class="text-sm font-semibold text-on-surface-variant">Ready</p>
        </div>
      </div>

      <!-- Current Stage -->
      <div class="rounded-2xl bg-surface-container-low p-4">
        <div class="flex items-start gap-3">
          <div
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary text-white"
          >
            <span class="animate-flame-pulse material-symbols-outlined">
              local_fire_department
            </span>
          </div>

          <div class="flex-1">
            <div class="flex items-center gap-2">
              <h3 class="font-headline font-bold text-on-surface">
                Stage 2: Fresh on the Grill
              </h3>

              <span
                class="animate-status-pulse h-2 w-2 shrink-0 rounded-full bg-tertiary"
              ></span>
            </div>

            <p class="mt-2 text-sm leading-6 text-on-surface-variant">
              The kitchen is preparing your flame-grilled order fresh right now.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Order Summary -->
    <section class="space-y-4 rounded-3xl bg-white p-5 shadow-sm">
      <div class="flex items-center justify-between">
        <h2 class="font-headline text-xl font-bold text-on-surface">
          Order Summary
        </h2>

        <span
          id = "order-item-count" class="rounded-full bg-surface-container px-3 py-1 text-xs font-bold text-on-surface-variant"
        >
          Order Items (0)
        </span>
      </div>

      <p class="text-sm text-on-surface-variant">Downtown Flagship</p>

   <!-- Order Items -->
<div id="order-items"></div>

      <!-- Total -->
      <div class="flex items-center justify-between pt-1">
        <div>
          <p class="font-bold text-on-surface">Total</p>
          <p class="mt-1 text-sm text-on-surface-variant">Paid via Apple Pay</p>
        </div>

        <p id="order-total" class="font-headline text-2xl font-bold text-primary">CAD 0.00</p>
      </div>

      <!-- Receipt Button -->
      <button
        type="button"
        class="flex w-full items-center justify-center gap-2 rounded-xl bg-primary-container py-3 font-bold text-on-primary-container transition hover:bg-primary"
      >
        <span class="material-symbols-outlined">receipt_long</span>
        View Full Receipt
      </button>
    </section>
  </main>

  <BottomNavBar active="order" />
</Layout>
<script>
  // Get the order number from the URL
  const params = new URLSearchParams(window.location.search);
  const orderNum = params.get("orderNum");

  // Get HTML elements
  const orderNumber = document.getElementById("order-number");
  const orderItemCount = document.getElementById("order-item-count");
  const orderItems = document.getElementById("order-items");
  const orderTotal = document.getElementById("order-total");

  async function loadOrder() {

    try {
      // Fetch order data from the backend
      const response = await fetch(
        `http://localhost:3000/orders/${orderNum}`
      );
      const order = await response.json();

      if (!response.ok) {
        throw new Error(order.message || "Order not found.");
      }

      // Display order information
      if (orderNumber) {
        orderNumber.textContent = `Order #${order.orderNum}`;
      }

      if (orderItemCount) {
        orderItemCount.textContent = `Order Items (${order.items.length})`;
      }

      if (orderItems) {
        orderItems.innerHTML = order.items
          .map(
            (item: {
              productName: string;
              quantity: number;
              unitPrice: number;
            }) => `
              <div class="flex items-start justify-between gap-4 border-b border-outline-variant/40 pb-4">
                <div class="flex gap-3">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-surface-container text-sm font-bold text-on-surface">
                    ${item.quantity}x
                  </span>
                  <h3 class="font-semibold text-on-surface">
                    ${item.productName}
                  </h3>
                </div>
                <p class="shrink-0 font-semibold text-on-surface">
                  CAD ${(item.unitPrice * item.quantity).toFixed(2)}
                </p>
              </div>
            `
          )
          .join("");
      }

      if (orderTotal) {
        orderTotal.textContent = `CAD ${Number(order.total).toFixed(2)}`;
      }
    } catch (error) {
      if (orderNumber) {
        orderNumber.textContent =
          error instanceof Error ? error.message : "Unable to load order.";
      }
    }
  }

  loadOrder();
</script>